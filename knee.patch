+def find_knee_vmin(values: NDArray) -> float:
+    """Find knee point in density distribution for suggested vmin cutoff.
+
+    Uses curvature analysis on log-scaled sorted density values to find
+    the inflection point where the distribution transitions from the
+    long tail (low-density background) to the steep rise (signal).
+
+    Args:
+        values: Sorted density values (ascending), must be positive
+
+    Returns:
+        Suggested vmin value at the knee point. Returns min value if
+        no clear knee is found or if array is too small.
+    """
+    if len(values) < 10:
+        return float(values[0]) if len(values) > 0 else 1e-10
+
+    # Work in log space for better knee detection
+    log_values = np.log10(values)
+
+    # Create normalized x-axis (percentile-like, 0 to 1)
+    n = len(log_values)
+    x = np.linspace(0, 1, n)
+
+    # Compute first and second derivatives using finite differences
+    # Use central differences for interior points
+    dy = np.gradient(log_values, x)
+    d2y = np.gradient(dy, x)
+
+    # Knee point is where curvature is maximum (highest acceleration)
+    # We want the point where the curve bends most sharply upward
+    # This is typically where d2y (second derivative) is maximum
+
+    # Focus on the lower portion of the distribution (first 70%)
+    # since we're looking for the transition out of the long tail
+    search_end = int(n * 0.7)
+    if search_end < 5:
+        search_end = min(n - 1, 5)
+
+    # Find maximum curvature in the search region
+    search_region = d2y[:search_end]
+    knee_idx = np.argmax(search_region)
+
+    # Sanity check: if knee is at very start, use 5th percentile instead
+    if knee_idx < int(n * 0.02):
+        knee_idx = max(int(n * 0.05), 1)
+
+    return float(values[knee_idx])
+
