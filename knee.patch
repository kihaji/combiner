+def compute_density_distribution(density: NDArray) -> dict:
+    """Compute density distribution data for UI visualization.
+
+    Extracts positive density values, sorts them, and computes percentiles
+    and suggested cutoff values for interactive adjustment.
+
+    Args:
+        density: 2D density array
+
+    Returns:
+        Dict with:
+        - values: Sorted non-zero density values (ascending)
+        - percentiles: Corresponding percentile for each value (0-100)
+        - auto_vmin: The auto-computed vmin (minimum positive or vmax/100)
+        - auto_vmax: The maximum density value
+        - suggested_vmin: Knee-detected cutoff suggestion
+    """
+    # Extract positive values
+    positive_values = density[density > 0]
+
+    if len(positive_values) == 0:
+        return {"values": [], "percentiles": [], "auto_vmin": 0.0, "auto_vmax": 0.0, "suggested_vmin": 0.0}
+
+    # Sort ascending
+    sorted_values = np.sort(positive_values)
+
+    # Compute percentiles (0-100 scale)
+    n = len(sorted_values)
+    percentiles = np.linspace(0, 100, n)
+
+    # Compute auto vmin/vmax (matching the logic in write_png)
+    auto_vmin = float(sorted_values[0])
+    auto_vmax = float(sorted_values[-1])
+    if auto_vmax / auto_vmin < 100:
+        auto_vmin = auto_vmax / 100
+
+    # Find suggested knee point
+    suggested_vmin = find_knee_vmin(sorted_values)
+
+    # Subsample if too many values (for reasonable JSON/transfer size)
+    max_points = 1000
+    if n > max_points:
+        indices = np.linspace(0, n - 1, max_points, dtype=int)
+        sorted_values = sorted_values[indices]
+        percentiles = percentiles[indices]
+
+    return {"values": sorted_values.tolist(), "percentiles": percentiles.tolist(), "auto_vmin": auto_vmin, "auto_vmax": auto_vmax, "suggested_vmin": suggested_vmin}
+
